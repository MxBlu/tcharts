                "schema": {
                  "type": "string",
                  "default": "NodePort",
                  "enum": [
                    {
                      "value": "NodePort",
                      "description": "Expose using a node port"
                    },
                    {
                      "value": "ClusterIP",
                      "description": "Cluster-internal only"
                    }
                  ]
                }
              },
              {
                "variable": "port",
                "label": "Service Port",
                "schema": {
                  "type": "int",
                  "default": 3000,
                  "min": 1,
                  "max": 65535
                }
              },
              {
                "variable": "targetPort",
                "label": "Container Port",
                "schema": {
                  "type": "int",
                  "default": 3000,
                  "min": 1,
                  "max": 65535
                }
              },
              {
                "variable": "nodePort",
                "label": "Node Port",
                "schema": {
                  "show_if": [

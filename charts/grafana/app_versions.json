              {
                "variable": "pullPolicy",
                "label": "Pull Policy",
                "schema": {
                  "type": "string",
                  "default": "IfNotPresent",
                  "enum": [
                    {
                      "value": "IfNotPresent",
                      "description": "Only pull if missing"
                    },
                    {
                      "value": "Always",
                      "description": "Always pull"
                    },
                    {
                      "value": "Never",
                      "description": "Never pull"
                    }
                  ]
                }
              }
            ]
          }
        },
        {
